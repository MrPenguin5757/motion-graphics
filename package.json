{
  "name": "curb-ads",
  "version": "1.0.0",
  "description": "Motion-graphics ad templates for the Curb app, built with Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "build:preview": "node scripts/build-preview.mjs",
    "render:9x16": "remotion render CurbAd-9x16 out/curb-9x16.mp4",
    "render:4x5": "remotion render CurbAd-4x5 out/curb-4x5.mp4",
    "render:1x1": "remotion render CurbAd-1x1 out/curb-1x1.mp4",
    "render:all": "npm run render:9x16 && npm run render:4x5 && npm run render:1x1",
    "tour:9x16": "remotion render CurbTour-9x16 out/curb-tour-9x16.mp4",
    "tour:4x5": "remotion render CurbTour-4x5 out/curb-tour-4x5.mp4",
    "tour:1x1": "remotion render CurbTour-1x1 out/curb-tour-1x1.mp4",
    "tour:all": "npm run tour:9x16 && npm run tour:4x5 && npm run tour:1x1",
    "reviews:9x16": "remotion render CurbReviews-9x16 out/curb-reviews-9x16.mp4",
    "reviews:4x5": "remotion render CurbReviews-4x5 out/curb-reviews-4x5.mp4",
    "reviews:1x1": "remotion render CurbReviews-1x1 out/curb-reviews-1x1.mp4",
    "reviews:all": "npm run reviews:9x16 && npm run reviews:4x5 && npm run reviews:1x1",
    "tourfull:9x16": "remotion render CurbTourFull-9x16 out/curb-tourfull-9x16.mp4",
    "tourfull:4x5": "remotion render CurbTourFull-4x5 out/curb-tourfull-4x5.mp4",
    "tourfull:1x1": "remotion render CurbTourFull-1x1 out/curb-tourfull-1x1.mp4",
    "tourfull:all": "npm run tourfull:9x16 && npm run tourfull:4x5 && npm run tourfull:1x1",
    "peryard:9x16": "remotion render CurbPerYard-9x16 out/curb-peryard-9x16.mp4",
    "peryard:4x5": "remotion render CurbPerYard-4x5 out/curb-peryard-4x5.mp4",
    "peryard:1x1": "remotion render CurbPerYard-1x1 out/curb-peryard-1x1.mp4",
    "peryard:all": "npm run peryard:9x16 && npm run peryard:4x5 && npm run peryard:1x1",
    "slowseason:9x16": "remotion render CurbSlowSeason-9x16 out/curb-slowseason-9x16.mp4",
    "slowseason:4x5": "remotion render CurbSlowSeason-4x5 out/curb-slowseason-4x5.mp4",
    "slowseason:1x1": "remotion render CurbSlowSeason-1x1 out/curb-slowseason-1x1.mp4",
    "slowseason:all": "npm run slowseason:9x16 && npm run slowseason:4x5 && npm run slowseason:1x1",
    "storefront:1x1": "remotion render StorefrontAd-1x1 out/storefront-1x1.mp4",
    "storefront:9x16": "remotion render StorefrontAd-9x16 out/storefront-9x16.mp4",
    "storefront:4x5": "remotion render StorefrontAd-4x5 out/storefront-4x5.mp4",
    "storefront:all": "npm run storefront:1x1 && npm run storefront:9x16 && npm run storefront:4x5",
    "why:1x1": "remotion render StorefrontWhy-1x1 out/storefront-why-1x1.mp4",
    "why:9x16": "remotion render StorefrontWhy-9x16 out/storefront-why-9x16.mp4",
    "why:4x5": "remotion render StorefrontWhy-4x5 out/storefront-why-4x5.mp4",
    "why:all": "npm run why:1x1 && npm run why:9x16 && npm run why:4x5",
    "how:9x16": "remotion render StorefrontHow-9x16 out/storefront-how-9x16.mp4",
    "how:1x1": "remotion render StorefrontHow-1x1 out/storefront-how-1x1.mp4",
    "how:4x5": "remotion render StorefrontHow-4x5 out/storefront-how-4x5.mp4",
    "how:all": "npm run how:9x16 && npm run how:1x1 && npm run how:4x5",
    "getpaid:9x16": "remotion render CurbGetPaid-9x16 out/curb-getpaid-9x16.mp4",
    "getpaid:4x5": "remotion render CurbGetPaid-4x5 out/curb-getpaid-4x5.mp4",
    "getpaid:1x1": "remotion render CurbGetPaid-1x1 out/curb-getpaid-1x1.mp4",
    "getpaid:all": "npm run getpaid:9x16 && npm run getpaid:4x5 && npm run getpaid:1x1"
  },
  "dependencies": {
    "@remotion/cli": "4.0.192",
    "@remotion/fonts": "4.0.192",
    "@remotion/transitions": "4.0.192",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.192"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
